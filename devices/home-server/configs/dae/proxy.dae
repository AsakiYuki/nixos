global {
    lan_interface: enp1s0
    wan_interface: auto
    log_level: info
    allow_insecure: false
    auto_config_kernel_parameter: true
}

subscription {
    ebrasha_free: "https://raw.githubusercontent.com/ebrasha/free-v2ray-public-list/refs/heads/main/V2Ray-Config-By-EbraSha-All-Type.txt"
}

dns {
    upstream {
        googledns: "tcp+udp://dns.google:53"
        alidns: "udp://dns.alidns.com:53"
    }
    routing {
        request {
            qtype(https) -> reject
            fallback: alidns
        }
        response {
            upstream(googledns) -> accept
            ip(geoip:private) && !qname(geosite:cn) -> googledns
            fallback: accept
        }
    }
}

group {
    proxy {
        filter: subtag(ebrasha_free)
        policy: min_moving_avg
    }
}

routing {
    dip(127.0.0.0/8, ::1/128) -> direct
    dip(224.0.0.0/3, "ff00::/8") -> direct
    dip(geoip:private) -> direct

    pname(NetworkManager) -> direct
    pname(AdGuardHome) -> direct
    pname(gitea) -> direct
    pname(sshd) -> direct

    dport(3000) -> direct
    dport(22) -> direct

    l4proto(udp) && dport(443) -> block

    dip(geoip:cn) -> direct
    domain(geosite:cn) -> direct

    fallback: proxy
}

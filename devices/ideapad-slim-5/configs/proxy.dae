global {
  wan_interface: wlo1
  dial_mode: domain
  log_level: debug
  allow_insecure: false
  auto_config_kernel_parameter: true
  disable_waiting_network: true
}

dns {
  upstream {
    cloudflare: 'tcp+udp://1.1.1.1:53'
  }
  routing {
    request {
      fallback: cloudflare
    }
  }
}

node {
  warp: 'socks5://127.0.0.1:1080'
}

group {
  proxy {
    filter: name(warp)
    policy: min_moving_avg
  }
}

routing {
  pname(NetworkManager) -> must_direct
  
  pname(ssh) -> must_direct
  dport(15523) -> must_direct
  
  dip(1.1.1.1) -> direct
  
  dip(224.0.0.0/3, 'ff00::/8') -> direct
  
  domain(suffix: roblox.com, suffix: rbxcdn.com, suffix: robloxlabs.com, suffix: rbxgame.com) -> proxy
  
  fallback: direct
}